# Domain, für die Caddy ein HTTPS-Zertifikat holt (DNS-A/AAAA-Eintrag muss auf den Server zeigen)
DOMAIN=swisstransportmap.juroct.net

# API-Key für GTFS-RT von https://api-manager.opentransportdata.swiss (Produkt GTFS-RT)
GTFS_RT_API_KEY=

# API-Key für GTFS-SA (Störungsmeldungen), eigenes Produkt mit eigenem Key; leer = ohne
GTFS_SA_API_KEY=

# Abfrageintervall in Sekunden (Plan mit 5 Abfragen/Minute: ab 12 s möglich)
GTFS_RT_INTERVAL=30

# Verkehrsmittel. Mit allen braucht der Server mehr Arbeitsspeicher (siehe README, "Betrieb auf einem VPS").
MODES=rail,tram,metro,bus,ship,cable,funicular
